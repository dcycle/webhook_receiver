FROM dcycle/drupal:11

# Cannot run apk del libsodium because it will result in the error:
#     the following packages are not removed due to:
#         libsodium: so:libsodium.so.26
#             .drupal-phpexts-rundeps
# So instead we will manually remove the files to mimick some Red Hat
# installations where Sodium is not present.

RUN rm -rf /usr/lib/libsodium.so* && \
    rm -rf /usr/local/lib/php/extensions/*/sodium* && \
    rm -rf /usr/local/etc/php/conf.d/*sodium*
